{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "patterson-corp": {
      "source": {
        "source": "github",
        "repo": "patterson-agents/patterson-corp"
      },
      "autoUpdate": false
    }
  },
  "permissions": {
    "deny": [
      "Bash(python)",
      "Bash(python:*)",
      "Bash(python2)",
      "Bash(python2:*)",
      "Bash(python3)",
      "Bash(python3:*)",
      "Bash(pip)",
      "Bash(pip:*)",
      "Bash(pip2)",
      "Bash(pip2:*)",
      "Bash(pip3)",
      "Bash(pip3:*)",
      "Bash(pipx)",
      "Bash(pipx:*)",
      "Bash(uv)",
      "Bash(uv:*)",
      "Bash(poetry)",
      "Bash(poetry:*)",
      "Bash(conda)",
      "Bash(conda:*)",
      "Bash(virtualenv)",
      "Bash(virtualenv:*)",
      "Bash(npm)",
      "Bash(npm:*)",
      "Bash(pnpm)",
      "Bash(pnpm:*)",
      "Bash(yarn)",
      "Bash(yarn:*)",
      "Bash(npx)",
      "Bash(npx:*)",
      "Write(//tmp/**)",
      "Edit(//tmp/**)",
      "Write(//var/tmp/**)",
      "Edit(//var/tmp/**)",
      "Write(//dev/shm/**)",
      "Edit(//dev/shm/**)",
      "Write(package-lock.json)",
      "Write(**/package-lock.json)",
      "Write(npm-shrinkwrap.json)",
      "Write(**/npm-shrinkwrap.json)",
      "Write(yarn.lock)",
      "Write(**/yarn.lock)",
      "Write(pnpm-lock.yaml)",
      "Write(**/pnpm-lock.yaml)",
      "Edit(package-lock.json)",
      "Edit(**/package-lock.json)",
      "Edit(npm-shrinkwrap.json)",
      "Edit(**/npm-shrinkwrap.json)",
      "Edit(yarn.lock)",
      "Edit(**/yarn.lock)",
      "Edit(pnpm-lock.yaml)",
      "Edit(**/pnpm-lock.yaml)"
    ]
  }
}
