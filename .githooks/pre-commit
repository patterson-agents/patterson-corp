#!/bin/sh
# .githooks/pre-commit -- fast local gate for patterson-corp.
#
# Runs every skill/hook test suite under plugins/ and the design-tokens theme round-trip
# before a commit is created. This is deliberately narrower than scripts/verify-all.sh (no
# size/binary/forbidden-string checks, and it does not run scripts/tests/run-tests.sh) --
# it exists to catch the two classes of drift that are cheapest to catch before the commit
# even exists: a broken standards validator, and theme.css diverging from tokens.json.
# scripts/verify-all.sh is the full gate; CI always runs that one too.
#
# Enable with:  git config core.hooksPath .githooks
#
# POSIX sh only. Fails loud and stops the commit on the first failing suite.
set -eu

ROOT=$(CDPATH= cd -- "$(git rev-parse --show-toplevel)" && pwd)
cd "$ROOT"

# --- secrets scanning: TruffleHog + Trivy -----------------------------------------------
# Both scan the working tree for credentials before the commit exists. Graceful skip when
# a scanner is not installed (install both with: mise use trufflehog trivy) -- the
# PreToolUse guards and GitHub push protection remain the backstops. The hook test
# fixtures' synthetic secrets are excluded (.trufflehog-exclude.txt / --skip-dirs), same
# as .github/secret_scanning.yml does for GitHub's scanner.
if command -v trufflehog >/dev/null 2>&1; then
  echo "pre-commit: trufflehog secret scan..."
  if ! trufflehog git "file://$ROOT" --since-commit HEAD --results=verified,unknown \
       --fail --no-update --exclude-paths "$ROOT/.trufflehog-exclude.txt" >/dev/null 2>&1; then
    echo "pre-commit: FAILED trufflehog found a secret in the pending changes." >&2
    echo "pre-commit: run 'trufflehog git file://. --since-commit HEAD --results=verified,unknown --no-update' to see it. commit blocked." >&2
    exit 1
  fi
else
  echo "pre-commit: trufflehog not installed -- skipping secret scan (mise use trufflehog)."
fi

if command -v trivy >/dev/null 2>&1; then
  echo "pre-commit: trivy secret scan..."
  if ! trivy fs --scanners secret --exit-code 1 --quiet \
       --skip-dirs plugins/patterson-engineering/hooks/tests "$ROOT" >/dev/null 2>&1; then
    echo "pre-commit: FAILED trivy found a secret in the working tree." >&2
    echo "pre-commit: run 'trivy fs --scanners secret --skip-dirs plugins/patterson-engineering/hooks/tests .' to see it. commit blocked." >&2
    exit 1
  fi
else
  echo "pre-commit: trivy not installed -- skipping secret scan (mise use trivy)."
fi

echo "pre-commit: running plugin test suites..."
suite_count=0
for suite in $(find plugins -name 'run-tests.sh' | sort); do
  suite_count=$((suite_count + 1))
  echo "  -> $suite"
  if ! sh "$suite"; then
    echo "pre-commit: FAILED $suite" >&2
    echo "pre-commit: commit blocked. Fix the failing suite or use --no-verify deliberately." >&2
    exit 1
  fi
done
echo "pre-commit: $suite_count plugin suite(s) passed."

THEME_VERIFY="plugins/patterson-brand/skills/design-tokens/scripts/verify-theme.sh"
if [ -f "$THEME_VERIFY" ]; then
  echo "pre-commit: verifying design-tokens theme round-trip..."
  if ! sh "$THEME_VERIFY"; then
    echo "pre-commit: FAILED $THEME_VERIFY" >&2
    echo "pre-commit: theme.css does not match tokens.json. Regenerate it with" >&2
    echo "  node plugins/patterson-brand/skills/design-tokens/scripts/build-theme.ts" >&2
    echo "and commit the result. commit blocked." >&2
    exit 1
  fi
fi

echo "pre-commit: OK"
